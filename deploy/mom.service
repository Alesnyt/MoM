[Unit]
Description=MoM meeting minutes service
After=network.target

[Service]
Type=simple
User=REPLACE_USER
Group=REPLACE_GROUP
WorkingDirectory=REPLACE_ROOT
# HOST/PORT and secrets are read by Python from .env (do not use EnvironmentFile:
# systemd would interpret $ in ADMIN_PASSWORD_HASH).
ExecStart=REPLACE_ROOT/.venv/bin/python -m backend
Restart=on-failure
RestartSec=5
Nice=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=REPLACE_ROOT
MemoryMax=6G

[Install]
WantedBy=multi-user.target
