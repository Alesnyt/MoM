server {
    listen 80;
    server_name ${SERVER_NAME};
    return 301 https://${SERVER_NAME}$request_uri;
}

server {
    listen 443 ssl;
    server_name ${SERVER_NAME};
    ssl_certificate /etc/nginx/ssl/nginx.crt;
    ssl_certificate_key /etc/nginx/ssl/nginx.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    error_log /var/log/nginx/error.log warn;

    # The authenticated application enforces MAX_UPLOAD_MB while streaming,
    # including multipart overhead. Do not introduce a second, lower limit here.
    client_max_body_size 0;
    client_body_timeout 60s;

    location / {
        proxy_pass http://mom:8000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Replace client-supplied headers; backend trusts only this proxy's IP.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 6000s;
    }
}
