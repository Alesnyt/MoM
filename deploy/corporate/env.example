# Copy to .env.corporate; application secrets/settings remain in .env.
SERVER_NAME=momer.example.internal
# Registry mirror prefix with trailing slash, e.g. registry.example/dockerhub/
DOCKER_PROXY=
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,mom,nginx
MAX_UPLOAD_MB=2048
INSTALL_DIARIZE=1
HTTP_PORT=80
HTTPS_PORT=443
# Select a subnet that does not overlap your corporate networks.
MOM_NETWORK_SUBNET=172.30.88.0/24
MOM_BACKEND_IP=172.30.88.2
MOM_PROXY_IP=172.30.88.3
