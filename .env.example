SETUP_TOKEN=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=qwen3.7-plus
WHISPER_MODEL=local-whisper
# WHISPER_MODEL=local-whisper-medium
# WHISPER_MODEL=gigaam-multilingual
# WHISPER_MODEL=gigaam-multilingual-large
LOCAL_WHISPER_SIZE=small
# 0 сохраняет прежний выбор Whisper: не более 8 доступных CPU-потоков.
# Положительное значение позволяет использовать больше 8, в пределах CPU affinity.
WHISPER_CPU_THREADS=0
# Общий лимит вычислительных потоков PyTorch для GigaAM и разметки спикеров.
# 0 сохраняет настройки PyTorch/окружения. Применяется после перезапуска сервиса.
TORCH_CPU_THREADS=0
ADMIN_USER=
ADMIN_PASSWORD_HASH=
HOST=0.0.0.0
PORT=8000
MAX_UPLOAD_MB=2048
# Не принимать новые записи, если свободно меньше этого запаса.
MIN_FREE_MB=2048
VERIFY_TIMEOUT_SECONDS=25
UI_THEME=classic
MAX_JOBS=1
# MAX_JOBS=4
PUBLIC_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1
ASR_IDLE_UNLOAD_SECONDS=300
LDAP_ENABLED=0
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
LDAP_USER_FILTER=(mail={username})
LDAP_STARTTLS=0
LDAP_TLS_VERIFY=1
LDAP_EMAIL_ATTR=mail
# Кто говорил. Токен Hugging Face и принятые условия pyannote/speaker-diarization-3.1
HF_TOKEN=
DIARIZE_MAX_SPEAKERS=8
DOCKER_PROXY=
SERVER_NAME=